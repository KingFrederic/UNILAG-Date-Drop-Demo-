# Copy to .env.local and fill in. .env.local is gitignored.
#
# Everything here is optional — the app builds and runs with none of it set.

# --- Assistant and agents -------------------------------------------------
# Without a key they run a built-in simulation: no key, no network, no cost.
# With one, both answer through NVIDIA NIM. The key is read only on the server
# (app/api/assistant, app/api/agents) and never reaches the browser.
# Get one at https://build.nvidia.com/
NVIDIA_API_KEY=

# Any model from the NVIDIA NIM catalogue.
# Defaults to meta/llama-3.3-70b-instruct when unset.
NVIDIA_MODEL=

# --- Idea board persistence ------------------------------------------------
# Without these the idea board saves to localStorage only, so ideas stay in
# one browser. With them, ideas persist to Postgres and follow you between
# devices. Run supabase/migrations/0001_ideas.sql against the project first.
# Both are read server-side only (app/api/ideas).
SUPABASE_URL=

# Service role key preferred; the anon key also works given the table's RLS
# policy. SUPABASE_KEY is accepted as an alias.
SUPABASE_SERVICE_ROLE_KEY=
