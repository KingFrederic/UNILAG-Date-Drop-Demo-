# Copy to .env.local and fill in. .env.local is gitignored.
#
# Optional. Without it the assistant runs its built-in simulation, which needs
# no key and costs nothing — the app works either way.
#
# With it, the assistant answers through NVIDIA NIM. The key is read only on
# the server (app/api/assistant/route.ts) and never reaches the browser.
# Get one at https://build.nvidia.com/
NVIDIA_API_KEY=

# Optional. Any model from the NVIDIA NIM catalogue.
# Defaults to meta/llama-3.3-70b-instruct when unset.
NVIDIA_MODEL=
